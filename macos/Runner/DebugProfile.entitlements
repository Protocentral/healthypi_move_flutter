<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- Without this the sandbox blocks CoreBluetooth outright: the app launches,
	     reports no adapter, and every scan returns nothing. That reads as broken
	     app code rather than a missing entitlement, which is why it is called out
	     here. macOS is the primary manual-test target for this app precisely
	     because it gives a real BLE host plus a real sqflite. -->
	<key>com.apple.security.device.bluetooth</key>
	<true/>
	<!-- Outbound network. Without it the sandbox blocks the GitHub releases API
	     with "Operation not permitted", and the firmware-update check reports
	     FirmwareUpdateState.unknown on every launch — which looks like a broken
	     update checker rather than a missing entitlement. `network.server` below
	     is for the Flutter debug VM service and does NOT cover outbound. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
