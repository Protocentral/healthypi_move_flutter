# Uncomment this line to define a global platform for your project
platform :ios, '13.1'

# file_picker: build the document picker only.
#
# Its podspec gates each picker behind a constant (`Pod.const_defined?`), and by
# default pulls in DKImagePickerController/PhotoGallery for media picking — which
# drags in DKPhotoGallery, SDWebImage and SwiftyGif, links the camera and photo
# library, and makes the App Store ask what we use them for. The app picks
# exactly one thing: a firmware .zip, via `FileType.custom` in
# `scr_dfu_new.dart` — that is the DOCUMENT path (UIDocumentPickerViewController)
# and needs none of it.
#
# These must be set before flutter_install_all_ios_pods evaluates the podspec.
# They also compile out the corresponding code (`#ifdef PICKER_MEDIA` in
# FilePickerPlugin.m), so requesting media/audio at runtime would fail — nothing
# does. If a future screen needs image or audio picking, flip the flag back on
# and restore the matching NS*UsageDescription in Info.plist.
# Object.const_set, not a plain `PICKER_MEDIA = false`: a Podfile is eval'd with
# its cref inside Pod::Podfile, so a plain assignment lands at
# Pod::Podfile::PICKER_MEDIA, where the podspec's Pod.const_defined?(:PICKER_MEDIA)
# cannot see it — the guard silently stays enabled and the pods come back.
Object.const_set(:PICKER_MEDIA, false)
Object.const_set(:PICKER_AUDIO, false)
Object.const_set(:PICKER_DOCUMENT, true)

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end
